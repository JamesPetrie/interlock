# pf_init_monitor_0 — MPF200-ETH-SENSOR-BRIDGE-R2 variant.
#
# Identical to the MPF300 kit's component except for which bank's VDDI status
# feeds CORERESET_PF: the kit used Bank 6 (its LED/clock bank); on this board
# the 3.3 V GPIO Bank 5 carries the 50 MHz oscillator, the UART and the SFP
# sideband, so its VDDI status is the one that must be up before the fabric
# reset releases.  (Bank 6 may be unpowered here — gating reset on it would
# hold the design in reset forever.)
create_and_configure_core -core_vlnv Actel:SgCore:PF_INIT_MONITOR:$PF_INIT_MONITORver -component_name {pf_init_monitor_0} -params {\
"BANK_0_CALIB_STATUS_ENABLED:false"  \
"BANK_0_CALIB_STATUS_SIMULATION_DELAY:1"  \
"BANK_0_RECALIBRATION_ENABLED:false"  \
"BANK_0_VDDI_STATUS_ENABLED:false"  \
"BANK_0_VDDI_STATUS_SIMULATION_DELAY:1"  \
"BANK_1_CALIB_STATUS_ENABLED:false"  \
"BANK_1_CALIB_STATUS_SIMULATION_DELAY:1"  \
"BANK_1_RECALIBRATION_ENABLED:false"  \
